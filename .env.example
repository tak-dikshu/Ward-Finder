# Public (safe in the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRET - server only. Never prefix with NEXT_PUBLIC_. Mark "Sensitive" in Vercel.
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated list of administrator emails allowed into /admin/import
WARD_FINDER_ADMIN_EMAILS=

# Public search: leave unset/false until all checks pass.
WARD_FINDER_REAL_SEARCH_ENABLED=false

# Random secret that protects the daily temp-file cleanup job (any long random string).
CRON_SECRET=
